<?xml version="1.0" encoding="utf-8"?>
<!-- Widget pequeño (C2). Antes: figura, «Core · 19 min» y Empezar. En marcha: figura, ejercicio, cantidad, Pausa y Hecho. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_fondo"
    android:orientation="vertical"
    android:padding="12dp">

    <ViewFlipper
        android:id="@+id/fig"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:autoStart="true"
        android:flipInterval="1400" />

    <LinearLayout
        android:id="@+id/mini_textos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/mini_nombre"
            style="@style/WT1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/mini_cant"
            style="@style/WT4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/mini_alt"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:visibility="gone"
            android:background="@drawable/w_btn_capa2"
            android:scaleType="center"
            android:src="@drawable/w_ic_pausa" />

        <LinearLayout
            android:id="@+id/mini_main"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/w_btn_accion"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/mini_main_ic"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/w_ic_play" />

            <TextView
                android:id="@+id/mini_main_txt"
                style="@style/WT2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:textColor="@color/w_sobre_accion"
                android:text="Empezar" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

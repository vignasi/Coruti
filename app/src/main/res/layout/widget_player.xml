<?xml version="1.0" encoding="utf-8"?>
<!-- Widget grande (C2). Antes de empezar: segmentos ★ Favorita · Core, figura, nombre y origen, duración, rondas y Empezar.
     En marcha: ronda y lo que queda arriba; figura, ejercicio, cantidad, banda y siguiente; progreso; Pausa y Hecho. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_fondo"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/seg_box"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/w_seg"
        android:orientation="horizontal"
        android:padding="1dp">

        <TextView
            android:id="@+id/seg_fav"
            style="@style/WSegmento"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="★ Favorita" />

        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/w_linea" />

        <TextView
            android:id="@+id/seg_core"
            style="@style/WSegmento"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Core" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/top_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/pos"
            style="@style/WT1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/quedan"
            style="@style/WT1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cuerpo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ViewFlipper
            android:id="@+id/fig"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="45"
            android:autoStart="true"
            android:flipInterval="1400" />

        <LinearLayout
            android:id="@+id/textos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="55"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nombre"
                style="@style/WT2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.15" />

            <TextView
                android:id="@+id/cantidad"
                style="@style/WT4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:visibility="gone" />

            <TextView
                android:id="@+id/linea1"
                style="@style/WT1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/linea2"
                style="@style/WT1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progreso"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="12dp"
        android:max="100"
        android:progressDrawable="@drawable/w_progreso"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/rondas_box"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/rondas_txt"
            style="@style/WT1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Rondas" />

        <ImageView
            android:id="@+id/btn_menos"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/w_btn_capa2"
            android:contentDescription="Una ronda menos"
            android:scaleType="center"
            android:src="@drawable/w_ic_menos" />

        <TextView
            android:id="@+id/rondas_n"
            style="@style/WT3"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:fontFeatureSettings="tnum" />

        <ImageView
            android:id="@+id/btn_mas"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/w_btn_capa2"
            android:contentDescription="Una ronda más"
            android:scaleType="center"
            android:src="@drawable/w_ic_mas" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_alt"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:visibility="gone"
            android:background="@drawable/w_btn_capa2"
            android:scaleType="center"
            android:src="@drawable/w_ic_pausa" />

        <LinearLayout
            android:id="@+id/btn_main"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/w_btn_accion"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/btn_main_ic"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/w_ic_play" />

            <TextView
                android:id="@+id/btn_main_txt"
                style="@style/WT2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:textColor="@color/w_sobre_accion"
                android:text="Empezar" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
